#!/usr/bin/env bash
# Run `make` for an Atari 8-bit project with the cc65 toolchain: inside the
# toolchain container (docker/Dockerfile, pinned cc65 + MADS) by default, or
# with a cc65 on PATH when A8_NATIVE=1 (or when Docker isn't available).
#
#   bin/a8-make [-C project_dir] [make args...]
#
# The repo is mounted at /work; projects outside the repo at /project.
source "$(dirname "$0")/../scripts/lib.sh"

proj="$PWD"
if [ "${1:-}" = "-C" ]; then proj="$(cd "$2" && pwd)"; shift 2; fi
[ -f "$proj/Makefile" ] || die "no Makefile in $proj"

native=0
if [ "${A8_NATIVE:-}" = 1 ]; then native=1
elif ! { have docker && docker info >/dev/null 2>&1; }; then
  have cl65 || die "no Docker and no cc65 on PATH: start Docker (or install cc65 and set A8_NATIVE=1)"
  warn "Docker not available: building with the cc65 on PATH ($(cc65 --version 2>&1 | head -1))"
  native=1
fi
if [ $native = 1 ]; then
  exec make -C "$proj" A8_SDK="$A8_ROOT/sdk" "$@"
fi

if ! docker image inspect "$TOOLCHAIN_IMAGE" >/dev/null 2>&1; then
  warn "toolchain image $TOOLCHAIN_IMAGE missing – building it"
  "$A8_ROOT/scripts/build-toolchain-image.sh" >&2 || die "could not build $TOOLCHAIN_IMAGE"
fi

mounts=(-v "$A8_ROOT:/work")
case "$proj/" in
  "$A8_ROOT"/*) cdir="/work/${proj#"$A8_ROOT"/}" ;;
  *)            cdir="/project"; mounts+=(-v "$proj:/project") ;;
esac
tty=(); [ -t 0 ] && [ -t 1 ] && tty=(-t)
exec docker run --rm ${tty[@]+"${tty[@]}"} -u "$(id -u):$(id -g)" -e HOME=/tmp \
  -e A8_SDK=/work/sdk "${mounts[@]}" -w "$cdir" "$TOOLCHAIN_IMAGE" make "$@"
