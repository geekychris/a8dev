diff --git a/src/sio.c b/src/sio.c
index 9a5b7104..9f7c31b8 100644
--- a/src/sio.c
+++ b/src/sio.c
@@ -1963,3 +1963,21 @@ void SIO_StateRead(void)
 /*
 vim:ts=4:sw=4:
 */
+
+#ifdef A8H
+/* a8h: power-on state for what Atari800's coldstart leaves behind: the serial
+   transfer and the "Overmind" sector-1 delay (3200 scanlines after a previous
+   read of sector 1 made a reboot ~10 frames slower than the first boot). */
+void SIO_A8H_PowerOn(void)
+{
+	CommandIndex = 0;
+	DataIndex = 0;
+	TransferStatus = SIO_NoFrame;
+	ExpectedBytes = 0;
+	memset(CommandFrame, 0, sizeof(CommandFrame));
+#ifndef NO_SECTOR_DELAY
+	delay_counter = 0;
+	last_ypos = 0;
+#endif
+}
+#endif
